# Copie este arquivo para .env e ajuste os valores.
# O .env NAO deve ser commitado (esta no .gitignore).

# --- Credenciais do MongoDB local (usadas pelo docker-compose) ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DB=ecommerce

# --- String de conexao usada pelos scripts de carga (issue #9) ---
# Local (Docker): o authSource=admin e necessario porque o usuario root
# e criado no banco "admin".
MONGO_URI=mongodb://admin:admin123@localhost:27017/?authSource=admin

# Atlas (acesso compartilhado do time) - preencha no SEU .env, nunca aqui:
# MONGO_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# --- DAG MongoDB Atlas -> Landing (issue #15) ---
# IDs das Connections cadastradas no Airflow. As credenciais ficam no Airflow,
# nao neste arquivo.
MONGO_CONN_ID=mongodb_atlas
S3_CONN_ID=minio_s3

LANDING_BUCKET=datalake
MONGO_DATABASE=ecommerce
MONGO_COLLECTIONS=clientes,categorias,fornecedores,produtos,cupons,pedidos,itens_pedido,pagamentos,entregas,avaliacoes
MONGO_INCREMENTAL_FIELD=updated_at
MONGO_BATCH_SIZE=1000
MONGO_CHECKPOINT_OVERLAP_HOURS=24
MONGO_TO_LANDING_SCHEDULE="*/15 * * * *"

# --- Estrutura Landing no MinIO / Amazon S3 (issue #10) ---
# MinIO local. Para Amazon S3, remova S3_ENDPOINT_URL.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
